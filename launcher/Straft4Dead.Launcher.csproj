<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows launcher: finds STRAFTAT and Left 4 Dead 2, installs BepInEx and Straft 4 Dead into its own profile,
       downloads the asset tools, builds the L4D2 assets from the player's own install and starts the game.
       Standalone; doesn't reference the plugin. .NET Framework 4.8 ships with Windows 10 and 11, so the exe is one
       small file with nothing else to install. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Straft4Dead.Launcher</RootNamespace>
    <AssemblyName>Straft4Dead-Launcher</AssemblyName>
    <Version>0.1.1</Version>
    <Product>Straft 4 Dead Launcher</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
</Project>
