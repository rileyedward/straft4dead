<Project Sdk="Microsoft.NET.Sdk">

  <!-- BepInEx 5 plugin for STRAFTAT (Unity 2021.3.45, Mono).
       Game references come from $(StraftatManaged) (set in Directory.Build.props.user) and are never copied. -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Straft4Dead.Plugin</AssemblyName>
    <BepInExPluginGuid>dev.riley.straft4dead</BepInExPluginGuid>
    <BepInExPluginName>Straft 4 Dead</BepInExPluginName>
    <Product>Straft 4 Dead</Product>
    <Description>Left 4 Dead 2 hordes, survivors and HUD inside STRAFTAT (local play, private lobbies only)</Description>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>Straft4Dead</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <Target Name="CheckGamePaths" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(StraftatManaged)' == '' Or !Exists('$(StraftatManaged)\Assembly-CSharp.dll')"
           Text="StraftatManaged is not set or wrong. Copy Directory.Build.props.user.example to Directory.Build.props.user and edit the paths." />
  </Target>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.*" IncludeAssets="compile" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
  </ItemGroup>

  <!-- Game assemblies: compile-time only (Private=false), resolved from the local install. -->
  <ItemGroup>
    <Reference Include="UnityEngine"><HintPath>$(StraftatManaged)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(StraftatManaged)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(StraftatManaged)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AIModule"><HintPath>$(StraftatManaged)\UnityEngine.AIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(StraftatManaged)\UnityEngine.AnimationModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(StraftatManaged)\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AssetBundleModule"><HintPath>$(StraftatManaged)\UnityEngine.AssetBundleModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule"><HintPath>$(StraftatManaged)\UnityEngine.UnityWebRequestModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UnityWebRequestAudioModule"><HintPath>$(StraftatManaged)\UnityEngine.UnityWebRequestAudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule"><HintPath>$(StraftatManaged)\UnityEngine.ScreenCaptureModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(StraftatManaged)\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(StraftatManaged)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(StraftatManaged)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(StraftatManaged)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(StraftatManaged)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(StraftatManaged)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.InputSystem"><HintPath>$(StraftatManaged)\Unity.InputSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Animation.Rigging"><HintPath>$(StraftatManaged)\Unity.Animation.Rigging.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(StraftatManaged)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="com.rlabrecque.steamworks.net"><HintPath>$(StraftatManaged)\com.rlabrecque.steamworks.net.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="FishNet.Runtime"><HintPath>$(StraftatManaged)\FishNet.Runtime.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- `dotnet build -p:Deploy=true` copies the plugin into BepInEx\plugins\Straft4Dead\. -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(Deploy)' == 'true'">
    <Error Condition="'$(BepInExDir)' == '' Or !Exists('$(BepInExDir)\core\BepInEx.dll')" Text="BepInExDir is not set or BepInEx is not installed there." />
    <MakeDir Directories="$(BepInExDir)\plugins\Straft4Dead" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExDir)\plugins\Straft4Dead" />
    <Message Importance="high" Text="Deployed $(TargetFileName) to $(BepInExDir)\plugins\Straft4Dead" />
  </Target>
</Project>
